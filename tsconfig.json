{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node", "./types/browser-timers"],
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "scripts", "vite.config.ts"],
  "exclude": ["src/problems/*/solution.ts", "src/problems/*/starter.ts", "src/problems/*/broken/*.ts", "src/problems/*/stages/*/*.ts", "src/problems/*/contract.ts", "scripts/usercode"]
}
