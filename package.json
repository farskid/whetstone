{
  "name": "practice-site",
  "private": true,
  "version": "0.1.0",
  "description": "Practice coding on the problems real libraries solve.",
  "homepage": "https://farskid.github.io/whetstone/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farskid/whetstone.git"
  },
  "bugs": {
    "url": "https://github.com/farskid/whetstone/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:pages": "BASE_PATH=/whetstone/ npm run build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.usercode.json",
    "verify": "tsx scripts/verify.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "verify:browser": "tsx scripts/browser-verify.ts",
    "verify:rules": "tsx scripts/rules-paint-check.ts",
    "verify:tags": "tsx scripts/sticky-tags-check.ts",
    "verify:analytics": "tsx scripts/analytics-check.ts",
    "verify:theme": "tsx scripts/theme-check.ts",
    "verify:status": "tsx scripts/status-check.ts",
    "verify:home-mobile": "tsx scripts/home-mobile-check.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "marked": "^18.1.2",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
